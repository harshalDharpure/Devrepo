# VenturePilot AI — Environment Configuration

# === Google ADK / Gemini ===
GOOGLE_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-pro
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=us-central1
# Set DEMO_MODE=false to invoke live Google ADK LlmAgent calls.
DEMO_MODE=true

# === MongoDB Atlas ===
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_DB=venturepilot

# === Retrieval (set USE_MOCK_RETRIEVAL=false for production) ===
USE_MOCK_RETRIEVAL=true
VERTEX_SEARCH_DATA_STORE=your-data-store-id
VERTEX_SEARCH_LOCATION=global

# === Backend ===
CORS_ORIGINS=http://localhost:3000
DEBUG=false

# === Frontend ===
NEXT_PUBLIC_API_URL=http://localhost:8000
